# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=rentlens

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18250
BACKEND_PORT=19250
DB_PORT=17750

# ---- 数据库 ----
DB_NAME=rentlens
DB_USER=rentlens
DB_PASSWORD=rentlens_pw_2026
DB_ROOT_PASSWORD=rentlens_root_2026

# ---- 安全 ----
JWT_SECRET=rentlens-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
# 采集业务时区（挂牌日/运行记录按 UTC+8 解释）
APP_TIMEZONE_OFFSET_MINUTES=480
# 演示用的采集限流退避基数（毫秒）；真实抓取时按 2 的幂次退避
CRAWL_BACKOFF_BASE_MS=800
